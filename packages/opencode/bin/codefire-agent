#!/usr/bin/env node

import childProcess from "child_process"
import fs from "fs"
import os from "os"
import path from "path"
import { fileURLToPath } from "url"

const forwardedSignals = ["SIGINT", "SIGTERM", "SIGHUP"]
const target = path.join(path.dirname(fileURLToPath(import.meta.url)), "opencode")

function applyCodeFireIsolation() {
  const home = process.env.CODEFIRE_AGENT_HOME || path.join(os.homedir(), ".codefire-agent")
  const dirs = {
    XDG_DATA_HOME: path.join(home, "data"),
    XDG_CONFIG_HOME: path.join(home, "config"),
    XDG_STATE_HOME: path.join(home, "state"),
    XDG_CACHE_HOME: path.join(home, "cache"),
    TMPDIR: path.join(home, "tmp"),
  }

  for (const dir of Object.values(dirs)) {
    fs.mkdirSync(dir, { recursive: true })
  }

  for (const [key, value] of Object.entries(dirs)) {
    process.env[key] = value
  }
  process.env.OPENCODE_CONFIG_DIR = path.join(home, "config", "opencode")
}

process.env.CODEFIRE_AGENT = "1"
applyCodeFireIsolation()

const child = childProcess.spawn(process.execPath, [target, ...process.argv.slice(2)], {
  stdio: "inherit",
  env: process.env,
})

child.on("error", (error) => {
  console.error(error.message)
  process.exit(1)
})

const forwarders = {}
for (const signal of forwardedSignals) {
  forwarders[signal] = () => {
    try {
      child.kill(signal)
    } catch {
      // The child may have already exited.
    }
  }
  process.on(signal, forwarders[signal])
}

child.on("exit", (code, signal) => {
  for (const forwardedSignal of forwardedSignals) {
    process.removeListener(forwardedSignal, forwarders[forwardedSignal])
  }

  if (signal) {
    process.kill(process.pid, signal)
    return
  }

  process.exit(typeof code === "number" ? code : 0)
})
